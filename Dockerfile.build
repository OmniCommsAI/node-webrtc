# Build wrtc.node for linux-x64
# Usage: docker build --platform linux/amd64 -f Dockerfile.build -t wrtc-builder .
#        docker cp $(docker create wrtc-builder):/app/build-linux-x64/Release/wrtc.node ./prebuilds/linux-x64/

FROM --platform=linux/amd64 node:20-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 ninja-build cmake pkg-config \
    libglib2.0-dev libgtk-3-dev libpulse-dev libasound2-dev \
    lsb-release sudo wget curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only files needed for build (not build-darwin-arm64 or node_modules)
COPY package.json package-lock.json* ./
COPY CMakeLists.txt ./
COPY scripts/ scripts/
COPY src/ src/
COPY lib/ lib/
COPY types/ types/

# Install npm dependencies (cmake-js, node-addon-api)
RUN npm install --ignore-scripts

# Create nix.gni for linux build
RUN printf 'is_clang=true\nuse_lld=false\nclang_use_chrome_plugins=false\nclang_base_path="/usr"\ntreat_warnings_as_errors=false\n' > nix.gni

# Build: downloads depot_tools + libwebrtc M98 (~6GB) + compiles ~3000 files.
# First build is slow (~1-3 hours). Docker layer caching makes rebuilds fast.
ENV TARGET_ARCH=x64
RUN npm run build
